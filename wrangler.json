{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mohua-translator",
  "main": "src/worker.ts",
  "compatibility_date": "2024-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "MOHUA_KV",
      "id": "25efe1d59e0f4f559622e626b2fd46a0"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
