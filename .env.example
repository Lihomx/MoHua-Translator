# =======================================================
# MoHua 墨华同传 - 环境变量配置示例
# 部署至 Cloudflare Pages 时，请在 Cloudflare 后台设置以下环境变量：
# Pages -> Settings -> Environment Variables
# =======================================================

# 1. Google Gemini API Key (免费额度充足，推荐主力使用)
# 获取地址: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq API Key (超低延迟 Llama-3，免费高速)
# 获取地址: https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenAI API Key (支持 GPT-4o-mini 高精度俚语翻译)
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=
